#!/usr/bin/env bash
# vmgputop configuration
# Copy to ~/.config/vmgputop/config.env and customize

# Connection
VM_HOST="user@192.168.1.100"
VM_LOGPATH="C:\path\to\log.CSV"

# Display
INTERACTIVE_MODE=FALSE
REFRESH_RATE=1
BOX_INNER_WIDTH=47
HORIZONTAL_CHAR="─"
BAR_WIDTH=22

# GPU tuning
MEM_CLOCK_MULTIPLIER=4
MEM_CLOCK_BOOST=500
VOLTAGE_MIN=0.700
VOLTAGE_MAX=1.200
TEMP_MIN=30
ORIGINAL_STTY=""

# Colours (hex)
C_RESET="\033[0m"
C_FG="\033[38;2;252;252;250m"
C_AQUA="\033[38;2;136;192;208m"
C_GREEN="\033[38;2;163;190;140m"
C_YELLOW="\033[38;2;235;203;139m"
C_RED="\033[38;2;255;97;136m"
C_ORANGE="\033[38;2;208;135;112m"
C_DIM="\033[38;2;94;105;135m"

# Colour percentage thresholds (descending)
C_1=80 # >= RED
C_2=60 # >= ORANGE
C_3=40 # >= YELLOW
       # <  GREEN

# HWiNFO CSV column names (exact match)
# If HWiNFO shows duplicate column names, rename them in HWiNFO's sensor settings
HW_TEMP="GPU Temperature [°C]"
HW_THERMAL_LIMIT="GPU Thermal Limit [°C]"
HW_VOLTAGE="GPU Core Voltage [V]"
HW_FAN_RPM="GPU Fan1 [RPM]"
HW_POWER_DRAW="GPU Power (Total) [W]"
HW_GPU_CLOCK="GPU Clock [MHz]"
HW_MEM_CLOCK="GPU Memory Clock [MHz]"
HW_GPU_LOAD="GPU Core Load [%]"
HW_FAN_PERCENT="GPU Fan1 [%]"
HW_MEM_AVAILABLE="GPU Memory Available [MB]"
HW_MEM_ALLOCATED="GPU Memory Allocated [MB]"

# Interactive mode
# Displays power mode in title bar, P key runs VM_SCRIPT
# Mode detected by grepping VM_CPUFREQ for VM_CPUFREQ_MARKER
VM_SCRIPT="/path/to/power-toggle-script"
VM_CPUFREQ="/sys/devices/system/cpu/cpu*/cpufreq/scaling_governor"
VM_CPUFREQ_MARKER="performance"
VM_BOOST="Boost"
VM_LIGHT="Light"
